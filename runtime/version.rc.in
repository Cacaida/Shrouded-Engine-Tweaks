// powrprof.dll's version resource, made by CMake: Properties > Details shows which version is installed.
#include <winver.h>

// Common Controls 6 for the link dialog (main.cpp linkDialog). 24 = RT_MANIFEST; ID 128 is never applied by Windows.
128 24 "@CMAKE_CURRENT_SOURCE_DIR@/comctl6.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Shrouded Engine Tweaks: Lua mods and an in-game overlay"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "Shrouded Engine Tweaks"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "powrprof.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
